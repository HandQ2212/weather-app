<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/white_40"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/white_50"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvHourTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/overpass_bold"
            android:text="@string/hour_item_time_placeholder"
            android:textColor="@color/forecast_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvHourTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/overpass_bold"
            android:text="@string/hour_item_temp_placeholder"
            android:textColor="@color/forecast_text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvHourCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/overpass"
            android:maxLines="2"
            android:text="@string/hour_item_condition_placeholder"
            android:textColor="@color/forecast_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvHourRain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/overpass"
            android:text="@string/hour_item_rain_placeholder"
            android:textColor="@color/forecast_text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvHourWind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/overpass"
            android:text="@string/hour_item_wind_placeholder"
            android:textColor="@color/forecast_text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
